# SPDX-License-Identifier: Apache-2.0
# The stack variables for the SearXNG workload. This is a list of names to enter in the Portainer stack
# environment over Twingate. Do not save a filled-in copy of this file in the repository.

# The host's private (VPC) address. No default on purpose: compose stops if it is unset.
SEARXNG_BIND=

# A long random string, generated for this instance and kept in Doppler. Left empty here on purpose.
SEARXNG_SECRET=

# Optional: where settings.yml and limiter.toml sit on the host (default /opt/cah/searxng/config).
#SEARXNG_CONFIG_DIR=/opt/cah/searxng/config

# Memory ceilings. These are starting points to test and tune, not measurements: SearXNG's documentation
# states no memory need (read 2026-11-01), and nothing here has run.
SEARXNG_CORE_MEM=768m
SEARXNG_VALKEY_MEM=64m
