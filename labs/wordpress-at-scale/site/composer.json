{
  "name": "example-vendor/example-site",
  "description": "A sample 'WordPress as code' manifest. Package names and versions are invented for teaching.",
  "type": "project",
  "license": "Apache-2.0",
  "require": {
    "php": "8.4.27",
    "example-vendor/wordpress-core": "6.8.0",
    "example-vendor/example-plugin-a": "2.3.1",
    "example-vendor/example-plugin-b": "1.9.0",
    "example-vendor/example-theme": "3.1.4"
  },
  "config": {
    "preferred-install": "dist",
    "sort-packages": true
  },
  "extra": {
    "installer-paths": {
      "web/app/plugins/{$name}/": ["type:wordpress-plugin"],
      "web/app/themes/{$name}/": ["type:wordpress-theme"]
    },
    "wordpress-install-dir": "web/wp"
  }
}
