# Copy to .env, or let `scripts/demo_monitoring.sh up` create .env for you with
# a random password. .env is untracked. Never commit a real value here.
GRAFANA_ADMIN_PASSWORD=
# Optional: override the loopback ports.
# DEMO_GRAFANA_PORT=3300
# DEMO_PROMETHEUS_PORT=9190
# Optional: start with a site already silent.
# DEMO_SILENT_SITE=site-tor2
