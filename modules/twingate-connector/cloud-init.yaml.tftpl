#cloud-config
# Hardened baseline for a Twingate connector droplet. SSH is reachable only
# through Twingate (the DigitalOcean firewall allows no inbound traffic); the
# sshd settings below are the second layer. Changing this file changes
# user_data, which forces a droplet rebuild.
disable_root: true
ssh_pwauth: false
package_update: true
package_upgrade: true
packages:
  - unattended-upgrades
  - chrony

users:
  - name: cah-admin
    gecos: CAH admin
    lock_passwd: true
    shell: /bin/bash
    groups: [sudo]
    sudo: ALL=(ALL) NOPASSWD:ALL
    ssh_authorized_keys:
      - ${admin_ssh_public_key}

write_files:
  - path: /etc/ssh/sshd_config.d/99-cah-hardening.conf
    permissions: "0644"
    content: |
      PermitRootLogin no
      PasswordAuthentication no
      KbdInteractiveAuthentication no
      PubkeyAuthentication yes
      X11Forwarding no
      AllowUsers cah-admin
      MaxAuthTries 3
      LoginGraceTime 20
  - path: /etc/apt/apt.conf.d/20auto-upgrades
    permissions: "0644"
    content: |
      APT::Periodic::Update-Package-Lists "1";
      APT::Periodic::Unattended-Upgrade "1";
  - path: /etc/apt/apt.conf.d/52cah-unattended-upgrades
    permissions: "0644"
    content: |
      Unattended-Upgrade::Allowed-Origins {
          "$${distro_id}:$${distro_codename}-security";
          "$${distro_id}ESMApps:$${distro_codename}-apps-security";
          "$${distro_id}ESM:$${distro_codename}-infra-security";
      };
      Unattended-Upgrade::Remove-Unused-Dependencies "true";
      Unattended-Upgrade::Automatic-Reboot "true";
      Unattended-Upgrade::Automatic-Reboot-WithUsers "true";
      Unattended-Upgrade::Automatic-Reboot-Time "${reboot_time}";
  - path: /etc/sysctl.d/99-cah-hardening.conf
    permissions: "0644"
    content: |
      # ip_forward is deliberately not set here: the connector may need it.
      # rp_filter is loose (2), not strict, so replies on the second interface survive.
      net.ipv4.conf.all.rp_filter = 2
      net.ipv4.conf.default.rp_filter = 2
      net.ipv4.conf.all.accept_redirects = 0
      net.ipv4.conf.default.accept_redirects = 0
      net.ipv4.conf.all.send_redirects = 0
      net.ipv4.conf.default.send_redirects = 0
      net.ipv6.conf.all.accept_redirects = 0
      net.ipv6.conf.default.accept_redirects = 0
      net.ipv4.conf.all.accept_source_route = 0
      net.ipv4.conf.default.accept_source_route = 0
      net.ipv6.conf.all.accept_source_route = 0
      net.ipv6.conf.default.accept_source_route = 0
      net.ipv4.tcp_syncookies = 1
      net.ipv4.conf.all.log_martians = 1
      net.ipv4.conf.default.log_martians = 1
  # Weekly connector update, from Twingate's systemd update guide. The two
  # connectors update an hour apart so they are never restarted together.
  - path: /etc/cron.d/twingate-connector-update
    permissions: "0644"
    content: |
      ${update_minute} ${update_hour} * * 0 root apt-get update -q && apt-get install -yq twingate-connector && systemctl restart twingate-connector

runcmd:
  - [sysctl, --system]
  - [bash, -c, "sshd -t && systemctl restart ssh"]
  - [systemctl, enable, --now, chrony]
  - [bash, -o, pipefail, -c, "curl -fsSL --proto '=https' --tlsv1.2 --retry 5 https://binaries.twingate.com/connector/setup.sh | TWINGATE_ACCESS_TOKEN='${access_token}' TWINGATE_REFRESH_TOKEN='${refresh_token}' TWINGATE_NETWORK='${network}' TWINGATE_LABEL_DEPLOYED_BY='opentofu' bash"]
