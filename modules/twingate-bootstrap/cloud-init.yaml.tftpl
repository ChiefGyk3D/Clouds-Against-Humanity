#cloud-config
# Hardened baseline for a Twingate connector droplet. SSH is reachable only
# through Twingate (the DigitalOcean firewall allows no inbound traffic); the
# sshd settings below are the second layer. Changing this file changes
# user_data, which forces a droplet rebuild.
disable_root: true
# Local time, so the reboot window and the weekly update below are Eastern.
timezone: ${timezone}
ssh_pwauth: false
package_update: true
package_upgrade: true
packages:
  - unattended-upgrades
  - chrony
%{ if metadata_lock || host_firewall ~}
  - nftables
%{ endif ~}

users:
  - name: cah-admin
    gecos: CAH admin
    lock_passwd: true
    shell: /bin/bash
    groups: [sudo]
    sudo: ALL=(ALL) NOPASSWD:ALL
    ssh_authorized_keys:
      - ${admin_ssh_public_key}

write_files:
  # First boot races Ubuntu's own apt-daily and unattended-upgrades for the
  # dpkg lock; wait for it instead of failing the Twingate install.
  # The connector config, written directly as in Twingate's own Terraform
  # (https://www.twingate.com/docs/terraform-aws). Root-only. The tokens appear
  # here and nowhere else in this file.
  - path: /etc/twingate/connector.conf
    permissions: "0600"
    owner: root:root
    content: |
      TWINGATE_URL=https://${network}.twingate.com
      TWINGATE_ACCESS_TOKEN=${access_token}
      TWINGATE_REFRESH_TOKEN=${refresh_token}
${telemetry_conf}%{ if metadata_lock ~}
  # Lock the droplet metadata endpoint (it serves this very user-data, tokens
  # included) to root and to the DigitalOcean monitoring agent's user. The rule
  # lives in its own nftables table, so it never touches any other rule.
  - path: /usr/local/sbin/cah-metadata-lock
    permissions: "0750"
    owner: root:root
    content: |
      #!/usr/bin/env bash
      set -euo pipefail
      # uid 0 always; the do-agent user too when it exists (DigitalOcean's
      # monitoring agent reads the metadata address as that user). AWS has none.
      allowed="0"
      if agent_uid="$(id -u do-agent 2>/dev/null)"; then
        allowed="0, $agent_uid"
      fi
      nft -f - <<EOF
      table inet cah_metadata
      delete table inet cah_metadata
      table inet cah_metadata {
        chain output {
          type filter hook output priority 0; policy accept;
          ip daddr 169.254.169.254 meta skuid != { $allowed } reject with icmp type admin-prohibited
        }
      }
      EOF
      echo "cah-metadata-lock: metadata endpoint allowed for uids: $allowed"
  # After cloud-final so the do-agent user already exists on first boot.
  - path: /etc/systemd/system/cah-metadata-lock.service
    permissions: "0644"
    content: |
      [Unit]
      Description=Restrict the droplet metadata endpoint to root and do-agent
      After=cloud-final.service network-online.target
      Wants=network-online.target

      [Service]
      Type=oneshot
      RemainAfterExit=yes
      ExecStart=/usr/local/sbin/cah-metadata-lock

      [Install]
      WantedBy=multi-user.target
%{ endif ~}
%{ if host_firewall ~}
  # A default-drop host firewall, the second layer behind the cloud firewall. It
  # lives in its own nftables table (inet cah_host), so it never flushes or
  # touches any other rule, including the metadata lock's table. Only the input
  # chain is filtered; output and forward are left alone.
  - path: /usr/local/sbin/cah-host-firewall
    permissions: "0750"
    owner: root:root
    content: |
      #!/usr/bin/env bash
      set -euo pipefail
      ssh_sources="${host_firewall_ssh_sources}"
      # Empty unless connector_telemetry.metrics_port is set.
      metrics_port="${host_firewall_metrics_port}"
      metrics_rule=""
      if [ -n "$metrics_port" ]; then
        metrics_rule="tcp dport $metrics_port ip saddr { $ssh_sources } accept"
      fi
      # Why each accept exists:
      #  - lo and established/related: local traffic and replies to what this
      #    machine started (the connector, apt, DNS, NTP all work on replies).
      #  - ICMPv4 echo, unreachable and time-exceeded: ping, and path MTU and
      #    error reporting.
      #  - ICMPv6 neighbour discovery and packet-too-big: the machines have no
      #    public IPv6, but link-local neighbour discovery must keep working.
      #  - DHCPv4 replies (server port 67 to client port 68): lease renewal.
      #  - TCP 22 and the metrics port: only from the private sources.
      # The same ruleset serves DigitalOcean and AWS.
      read -r -d '' ruleset <<EOF || true
      table inet cah_host
      delete table inet cah_host
      table inet cah_host {
        chain input {
          type filter hook input priority 0; policy drop;
          iifname "lo" accept
          ct state established,related accept
          ct state invalid drop
          icmp type { echo-request, destination-unreachable, time-exceeded } accept
          icmpv6 type { destination-unreachable, packet-too-big, time-exceeded, echo-request, nd-router-advert, nd-neighbor-solicit, nd-neighbor-advert } accept
          udp sport 67 udp dport 68 accept
          tcp dport 22 ip saddr { $ssh_sources } accept
          $metrics_rule
        }
      }
      EOF
      # Refuse a ruleset that does not parse, before anything changes.
      if ! printf '%s\n' "$ruleset" | nft -c -f -; then
        echo "cah-host-firewall: refusing to apply: the ruleset does not parse" >&2
        exit 1
      fi
      printf '%s\n' "$ruleset" | nft -f -
      # Verify, and roll back (delete only our own table) if the machine could
      # no longer be reached over SSH.
      listening=""
      listed=""
      listening="$(ss -H -ltn)" || listening=""
      listed="$(nft list table inet cah_host)" || listed=""
      if [[ ! "$listening" =~ :22[[:space:]] ]] || [[ "$listed" != *"tcp dport 22"* ]]; then
        echo "cah-host-firewall: verification failed (sshd not listening on 22, or the ssh accept is not loaded): removing the table" >&2
        nft delete table inet cah_host || echo "cah-host-firewall: could not delete the table" >&2
        exit 1
      fi
      echo "cah-host-firewall: loaded; ssh and metrics allowed from: $ssh_sources"
  - path: /etc/systemd/system/cah-host-firewall.service
    permissions: "0644"
    content: |
      [Unit]
      Description=Default-drop host firewall (inet cah_host)
      After=cloud-final.service network-online.target
      Wants=network-online.target

      [Service]
      Type=oneshot
      RemainAfterExit=yes
      ExecStart=/usr/local/sbin/cah-host-firewall

      [Install]
      WantedBy=multi-user.target
%{ endif ~}
  - path: /etc/apt/apt.conf.d/99cah-lock-wait
    permissions: "0644"
    content: |
      DPkg::Lock::Timeout "300";
  - path: /etc/ssh/sshd_config.d/99-cah-hardening.conf
    permissions: "0644"
    content: |
      PermitRootLogin no
      PasswordAuthentication no
      KbdInteractiveAuthentication no
      PubkeyAuthentication yes
      X11Forwarding no
      AllowUsers cah-admin
      MaxAuthTries 3
      LoginGraceTime 20
  - path: /etc/apt/apt.conf.d/20auto-upgrades
    permissions: "0644"
    content: |
      APT::Periodic::Update-Package-Lists "1";
      APT::Periodic::Unattended-Upgrade "1";
  - path: /etc/apt/apt.conf.d/52cah-unattended-upgrades
    permissions: "0644"
    content: |
      Unattended-Upgrade::Allowed-Origins {
          "$${distro_id}:$${distro_codename}-security";
          "$${distro_id}ESMApps:$${distro_codename}-apps-security";
          "$${distro_id}ESM:$${distro_codename}-infra-security";
      };
      Unattended-Upgrade::Remove-Unused-Dependencies "true";
      Unattended-Upgrade::Automatic-Reboot "true";
      Unattended-Upgrade::Automatic-Reboot-WithUsers "true";
      Unattended-Upgrade::Automatic-Reboot-Time "${reboot_time}";
  - path: /etc/sysctl.d/99-cah-hardening.conf
    permissions: "0644"
    content: |
      # ip_forward is deliberately not set here: the connector may need it.
      # rp_filter is loose (2), not strict, so replies on the second interface survive.
      net.ipv4.conf.all.rp_filter = 2
      net.ipv4.conf.default.rp_filter = 2
      net.ipv4.conf.all.accept_redirects = 0
      net.ipv4.conf.default.accept_redirects = 0
      net.ipv4.conf.all.send_redirects = 0
      net.ipv4.conf.default.send_redirects = 0
      net.ipv6.conf.all.accept_redirects = 0
      net.ipv6.conf.default.accept_redirects = 0
      net.ipv4.conf.all.accept_source_route = 0
      net.ipv4.conf.default.accept_source_route = 0
      net.ipv6.conf.all.accept_source_route = 0
      net.ipv6.conf.default.accept_source_route = 0
      net.ipv4.tcp_syncookies = 1
      net.ipv4.conf.all.log_martians = 1
      net.ipv4.conf.default.log_martians = 1
  # Weekly connector update, from Twingate's systemd update guide. The two
  # connectors update an hour apart so they are never restarted together.
  - path: /etc/cron.d/twingate-connector-update
    permissions: "0644"
    content: |
      ${update_minute} ${update_hour} * * 0 root apt-get update -q && apt-get install -yq twingate-connector && systemctl restart twingate-connector

runcmd:
  - [sysctl, --system]
  - [bash, -c, "sshd -t && systemctl restart ssh"]
  - [systemctl, enable, --now, chrony]
%{ if metadata_lock ~}
  # --no-block is required: the unit waits for cloud-final, which is what runs
  # this very command, so waiting here would deadlock.
  - [systemctl, daemon-reload]
  - [systemctl, enable, --now, --no-block, cah-metadata-lock.service]
%{ endif ~}
%{ if host_firewall ~}
  # --no-block for the same reason. The firewall only filters inbound traffic and
  # allows replies, so it can come up before the connector installs.
  - [systemctl, daemon-reload]
  - [systemctl, enable, --now, --no-block, cah-host-firewall.service]
%{ endif ~}
  # Install the connector from Twingate's signed apt repository and start it,
  # the way their Terraform guide does, instead of running their setup.sh (an
  # installer that is piped into bash can have its script swallowed by apt's
  # package configuration). The repository key is checked against a pinned
  # fingerprint before it is trusted. Success means the service is active.
  # Retry up to 10 times, 30 seconds apart. Never add set -x here.
  - - bash
    - -o
    - pipefail
    - -c
    - |
      export DEBIAN_FRONTEND=noninteractive NEEDRESTART_MODE=a
      KEYRING=/usr/share/keyrings/twingate-connector-keyring.gpg
      FPR=EC952DEE4701A407A82B0C505C363F09A9174A9E
      for attempt in $(seq 1 10); do
        if curl -fsSL --proto '=https' --tlsv1.2 --retry 5 -o /root/twingate.gpg.key https://packages.twingate.com/apt/gpg.key \
          && gpg --show-keys --with-colons /root/twingate.gpg.key | grep -q "^fpr:::::::::$FPR:" \
          && gpg --dearmor --yes -o "$KEYRING" /root/twingate.gpg.key \
          && echo "deb [signed-by=$KEYRING] https://packages.twingate.com/apt/ /" > /etc/apt/sources.list.d/twingate.list \
          && apt-get update -q \
          && apt-get install -yq twingate-connector \
          && systemctl enable --now twingate-connector \
          && sleep 5 && systemctl is-active --quiet twingate-connector; then
          echo "cah: connector install succeeded on attempt $attempt"
          exit 0
        fi
        echo "cah: connector install attempt $attempt of 10 failed"
        sleep 30
      done
      echo "cah: connector install failed after 10 attempts" >&2
      exit 1
  # Leave the outcome where someone can read it later. No token is read here.
  - - bash
    - -c
    - |
      umask 027
      {
        echo "== date"; date
        echo "== systemctl is-active twingate-connector"; systemctl is-active twingate-connector
        echo "== journalctl -u twingate-connector (last 50)"; journalctl -u twingate-connector -n 50 --no-pager
        echo "== /var/log/cloud-init-output.log (last 50)"; tail -n 50 /var/log/cloud-init-output.log
      } > /var/log/cah-connector-install.log 2>&1
      chmod 0640 /var/log/cah-connector-install.log
