#cloud-config
# Hardened baseline for a Twingate connector droplet. SSH is reachable only
# through Twingate (the DigitalOcean firewall allows no inbound traffic); the
# sshd settings below are the second layer. Changing this file changes
# user_data, which forces a droplet rebuild.
disable_root: true
# Local time, so the reboot window and the weekly update below are Eastern.
timezone: ${timezone}
ssh_pwauth: false
package_update: true
package_upgrade: true
packages:
  - unattended-upgrades
  - chrony

users:
  - name: cah-admin
    gecos: CAH admin
    lock_passwd: true
    shell: /bin/bash
    groups: [sudo]
    sudo: ALL=(ALL) NOPASSWD:ALL
    ssh_authorized_keys:
      - ${admin_ssh_public_key}

write_files:
  # First boot races Ubuntu's own apt-daily and unattended-upgrades for the
  # dpkg lock; wait for it instead of failing the Twingate install.
  # The connector config, written directly as in Twingate's own Terraform
  # (https://www.twingate.com/docs/terraform-aws). Root-only. The tokens appear
  # here and nowhere else in this file.
  - path: /etc/twingate/connector.conf
    permissions: "0600"
    owner: root:root
    content: |
      TWINGATE_URL=https://${network}.twingate.com
      TWINGATE_ACCESS_TOKEN=${access_token}
      TWINGATE_REFRESH_TOKEN=${refresh_token}
  - path: /etc/apt/apt.conf.d/99cah-lock-wait
    permissions: "0644"
    content: |
      DPkg::Lock::Timeout "300";
  - path: /etc/ssh/sshd_config.d/99-cah-hardening.conf
    permissions: "0644"
    content: |
      PermitRootLogin no
      PasswordAuthentication no
      KbdInteractiveAuthentication no
      PubkeyAuthentication yes
      X11Forwarding no
      AllowUsers cah-admin
      MaxAuthTries 3
      LoginGraceTime 20
  - path: /etc/apt/apt.conf.d/20auto-upgrades
    permissions: "0644"
    content: |
      APT::Periodic::Update-Package-Lists "1";
      APT::Periodic::Unattended-Upgrade "1";
  - path: /etc/apt/apt.conf.d/52cah-unattended-upgrades
    permissions: "0644"
    content: |
      Unattended-Upgrade::Allowed-Origins {
          "$${distro_id}:$${distro_codename}-security";
          "$${distro_id}ESMApps:$${distro_codename}-apps-security";
          "$${distro_id}ESM:$${distro_codename}-infra-security";
      };
      Unattended-Upgrade::Remove-Unused-Dependencies "true";
      Unattended-Upgrade::Automatic-Reboot "true";
      Unattended-Upgrade::Automatic-Reboot-WithUsers "true";
      Unattended-Upgrade::Automatic-Reboot-Time "${reboot_time}";
  - path: /etc/sysctl.d/99-cah-hardening.conf
    permissions: "0644"
    content: |
      # ip_forward is deliberately not set here: the connector may need it.
      # rp_filter is loose (2), not strict, so replies on the second interface survive.
      net.ipv4.conf.all.rp_filter = 2
      net.ipv4.conf.default.rp_filter = 2
      net.ipv4.conf.all.accept_redirects = 0
      net.ipv4.conf.default.accept_redirects = 0
      net.ipv4.conf.all.send_redirects = 0
      net.ipv4.conf.default.send_redirects = 0
      net.ipv6.conf.all.accept_redirects = 0
      net.ipv6.conf.default.accept_redirects = 0
      net.ipv4.conf.all.accept_source_route = 0
      net.ipv4.conf.default.accept_source_route = 0
      net.ipv6.conf.all.accept_source_route = 0
      net.ipv6.conf.default.accept_source_route = 0
      net.ipv4.tcp_syncookies = 1
      net.ipv4.conf.all.log_martians = 1
      net.ipv4.conf.default.log_martians = 1
  # Weekly connector update, from Twingate's systemd update guide. The two
  # connectors update an hour apart so they are never restarted together.
  - path: /etc/cron.d/twingate-connector-update
    permissions: "0644"
    content: |
      ${update_minute} ${update_hour} * * 0 root apt-get update -q && apt-get install -yq twingate-connector && systemctl restart twingate-connector

runcmd:
  - [sysctl, --system]
  - [bash, -c, "sshd -t && systemctl restart ssh"]
  - [systemctl, enable, --now, chrony]
  # Install the connector from Twingate's signed apt repository and start it,
  # the way their Terraform guide does, instead of running their setup.sh (an
  # installer that is piped into bash can have its script swallowed by apt's
  # package configuration). The repository key is checked against a pinned
  # fingerprint before it is trusted. Success means the service is active.
  # Retry up to 10 times, 30 seconds apart. Never add set -x here.
  - - bash
    - -o
    - pipefail
    - -c
    - |
      export DEBIAN_FRONTEND=noninteractive NEEDRESTART_MODE=a
      KEYRING=/usr/share/keyrings/twingate-connector-keyring.gpg
      FPR=EC952DEE4701A407A82B0C505C363F09A9174A9E
      for attempt in $(seq 1 10); do
        if curl -fsSL --proto '=https' --tlsv1.2 --retry 5 -o /root/twingate.gpg.key https://packages.twingate.com/apt/gpg.key \
          && gpg --show-keys --with-colons /root/twingate.gpg.key | grep -q "^fpr:::::::::$FPR:" \
          && gpg --dearmor --yes -o "$KEYRING" /root/twingate.gpg.key \
          && echo "deb [signed-by=$KEYRING] https://packages.twingate.com/apt/ /" > /etc/apt/sources.list.d/twingate.list \
          && apt-get update -q \
          && apt-get install -yq twingate-connector \
          && systemctl enable --now twingate-connector \
          && sleep 5 && systemctl is-active --quiet twingate-connector; then
          echo "cah: connector install succeeded on attempt $attempt"
          exit 0
        fi
        echo "cah: connector install attempt $attempt of 10 failed"
        sleep 30
      done
      echo "cah: connector install failed after 10 attempts" >&2
      exit 1
  # Leave the outcome where someone can read it later. No token is read here.
  - - bash
    - -c
    - |
      umask 027
      {
        echo "== date"; date
        echo "== systemctl is-active twingate-connector"; systemctl is-active twingate-connector
        echo "== journalctl -u twingate-connector (last 50)"; journalctl -u twingate-connector -n 50 --no-pager
        echo "== /var/log/cloud-init-output.log (last 50)"; tail -n 50 /var/log/cloud-init-output.log
      } > /var/log/cah-connector-install.log 2>&1
      chmod 0640 /var/log/cah-connector-install.log
